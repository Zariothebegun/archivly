# ============================================================
# .env.example - copia para .env e preenche o que quiseres.
# NENHUMA variável é obrigatória para a app arrancar:
# sem elas o Archivly funciona em "modo local"
# (ficheiros no disco do servidor + sites servidos em /sites/<nome>/).
# ============================================================

# --- Obrigatório em produção (qualquer texto aleatório longo) ---
SECRET_KEY=troca-isto-por-uma-string-aleatoria-longa

# --- GitHub Pages (opcional) ---
# Sem isto, os sites são publicados localmente na própria app.
# Token: github.com/settings/tokens?type=beta
#   Permissões: Administration (R/W), Contents (R/W), Pages (R/W)
GITHUB_TOKEN=
GITHUB_USERNAME=

# --- Cloudflare R2 (opcional) ---
# Sem isto, os ficheiros ficam guardados no disco do servidor (pasta data/).
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=archivly-files
R2_PUBLIC_URL=

# --- Ajustes (opcional) ---
# URL público da app. No Render não é preciso: RENDER_EXTERNAL_URL é usado automaticamente.
PUBLIC_BASE_URL=
# Caminhos alternativos para a base de dados e para os ficheiros
DATABASE_PATH=data/archivly.db
LOCAL_MEDIA_DIR=data/media
LOCAL_SITES_DIR=data/sites
# Tamanho máximo por ficheiro enviado
MAX_UPLOAD_MB=100
# Porta usada pelo servidor
PORT=8000
